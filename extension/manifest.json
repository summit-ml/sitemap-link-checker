{
    "manifest_version": 3,
    "name": "Sitemap Link Checker",
    "version": "0.1.0",
    "description": "Check every link in a sitemap from the site you are on: real page, redirect, not found, no results or error.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Check sitemap links on this site",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["activeTab", "scripting"]
}
